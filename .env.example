# Copy this file to .env and choose your own password. .env is git-ignored; never commit it.
POSTGRES_USER=trustauth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trustauth

# mock = mock factors only; real = real factors where they exist, mocks for the rest
FACTOR_MODE=mock

# Researcher endpoints (/admin/study-label, /admin/attempts.csv). Leave empty to switch them off.
# For study sessions, set a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
