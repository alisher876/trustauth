#!/bin/sh
# Blocks direct pushes to main. Work on a branch (m<N>-<task>) and open a Pull Request.
#
# Install once (Git Bash on Windows, or any terminal on macOS/Linux):
#   cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Git passes one line per ref being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "pre-push: direct pushes to 'main' are not allowed."
        echo "pre-push: push your branch (e.g. m4-risk-score) and open a Pull Request instead."
        exit 1
    fi
done

exit 0
